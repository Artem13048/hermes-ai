# ============================================================
# MAX Bot API
# ============================================================
# Токен бота в MAX (получите в @MasterBot)
MAX_BOT_TOKEN=your_max_bot_token_here

# Секрет для webhook (5–256 символов)
MAX_WEBHOOK_SECRET=your_webhook_secret_here

# Публичный HTTPS-адрес, куда MAX будет слать события
WEBHOOK_URL=https://your-domain.com/webhook

# Путь к файлу сертификатов Минцифры
MAX_CA_BUNDLE=certificates.pem


# ============================================================
# База данных
# ============================================================
# Формат: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://hermes:hermes_password@db:5432/hermes


# ============================================================
# Админы
# ============================================================
# ID пользователей через запятую (без пробелов)
ADMIN_IDS=123456789,987654321


# ============================================================
# GigaChat
# ============================================================
# Authorization key из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here


# ============================================================
# Внешние API
# ============================================================
# API-ключ Яндекс.Карт (Static API)
YANDEX_MAPS_API_KEY=your_yandex_maps_key_here

# API-ключ OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_key_here


# ============================================================
# Приложение
# ============================================================
# Порт FastAPI (по умолчанию 8000)
API_PORT=8000